{
  "expo": {
    "name": "FlaxFlow",
    "slug": "flaxia-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flaxflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "br.com.flaxia.mobile",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#22506B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "br.com.flaxia.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#22506B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permite fotografar documentos para enviar aos seus projetos.",
          "photosPermission": "Permite selecionar imagens de documentos para enviar aos seus projetos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "roberto-fernandino031s-team",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e4bdca21-b8cb-4082-b361-9a1fcf020368"
      }
    }
  }
}
